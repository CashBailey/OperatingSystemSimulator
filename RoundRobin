#include <iostream>
#include <vector>
#include <algorithm> // for sorting
#include <cstdlib> // for rand()
#include <ctime>	// for time()
using namespace std;

enum class ProcessState
{
	New,
	Ready,
	Running,
	Waiting,
	Terminated

};

class Process
{
public:
	// Core Attributes
	int pid;	// Uniuque process ID
	int arrival_time;	// Time process enters the system 
	int Cpu_burst;	// Total Cpu time required
	int IO_burst;	// Total I/O time required
	int priority;	// Scheduling priority
	ProcessState state;	// Current process state

	// Time Tracking
	int remaining_time;	// Cpu time left for comletion
	int waiting_time;	// Time spent waiting in Ready queue
	int turnaround_time;	// time from arrival to completion
	int completion_time;	// Time process finished execution
	int average_turnaround; // average time from arrival to completion
	int average_waitingtime; // average time from time spent waiting in Ready

	// Memory and I/O
	int memory_required;	// Bytes or KB required by the process
	const int* io_milestone;	// Array of I/O request milestones
	size_t io_count;	// Number of I/O milestones
	size_t io_next_index;	// Index of the next I/O operation

	// Execution Statistics
	int cpu_executed;



	// constructor
	Process(int pid, int arrival, int cpu, int io, int prio, int mem)
		: pid(pid), arrival_time(arrival), Cpu_burst(cpu), IO_burst(io), priority(prio), memory_required(mem), state(ProcessState::New), remaining_time(cpu), waiting_time(0), turnaround_time(0), completion_time(0),
		io_milestone(nullptr), io_count(0), io_next_index(0), cpu_executed(0){ }
};


// initilizes several process with values
Process ProcessCreation(int pid)
{
	int arrival = rand() % 10;	// random 0 - 9
	int cpu = 5 + rand() % 15;	// random 5 - 19
	int io = rand() % 5;	// random 0 - 4
	int prio = 1 + rand() % 3;	// Priority 1 - 3
	int mem = 256 + rand() % 1024; // random 256 - 1279 KB

	return Process(pid, arrival, cpu, io, prio, mem);
};



int main()
{
	srand(time(nullptr)); // seed randomness

	int random_number_of_processes = 1 + rand() % 10; // this generates a random number of processes from 1 - 10
	
	vector<Process> processes; // vector for the processes
	vector<Process> Ready; // ready queue
	vector<Process> Execution; // Executing Processes
	vector<Process> Terminated; // Process that has terminated
	
	int elapsedTime = 0;
	int quantumTime = 5;

	cout << "Number of processes generated: " << random_number_of_processes << endl;// Prints the number of processes generated
	
	// Generates Process
	for (int i = 1; i <= random_number_of_processes; i++)
	{
		processes.push_back(ProcessCreation(i));

	}

	// Sort the processes by arrival time
	sort(processes.begin(), processes.end(), [](const Process &a, const Process &b)
	{
		return a.arrival_time < b.arrival_time;
	});

	// push the sorted array into the ready Queue
	for (int i = 0; i < processes.size(); i++)
	{
		Ready.push_back(processes[i]);
	}

	//prints out the process by arrival time
	for (int i = 0; i < Ready.size(); i++)
	{
		cout << "\nProcess " << processes[i].pid << " has arrived";

		cout << "\nPID = " << processes[i].pid
			<< "\nArrival = " << processes[i].arrival_time
			<< "\nCpu Burst = " << processes[i].Cpu_burst
			<< "\nPriority = " << processes[i].priority
			<< "\nMemory = " << processes[i].memory_required << endl;
	}

	
	
	// Round Robin CPU execution
	while (!Ready.empty())
	{
		// Gets the first process in the Ready queue
		Process current = Ready.front();
		Ready.erase(Ready.begin()); // Takes it out of the queue
		current.state = ProcessState::Running; // Switches states

		Execution.push_back(current); // Pushes it in the Exexcution queue or "CPU"

		cout << "\nProcess " << current.pid << " moved from Ready to Running.\n"; // Prints out which process just took the CPU

		int timeSlice = min(quantumTime, current.remaining_time); // this is the quantam bursts
		current.remaining_time -= timeSlice; // subtracts the quantam bursts from the Process CPU bursts
		elapsedTime += timeSlice;

		cout << "Process " << current.pid << " executed for " << timeSlice << " quantam bursts and now has " << current.remaining_time << " CPU bursts" << endl; // Tells us which process exectuted for the quantam bursts

		Execution.pop_back(); // Takes out the Process from CPU

		//checks if the Process still has CPU bursts remaining
		if (current.remaining_time > 0)
		{
			current.state = ProcessState::Ready;// Switches states
			Ready.push_back(current);// pushes it back to the Ready queue
			cout << "Process " << current.pid << " preempted and moved from Running to Ready.\n";// tells us which process just went from running to waiting
		}
		// THis part calculates the times
		else
		{
			current.state = ProcessState::Terminated;// switches from Running to terminated
			current.completion_time = elapsedTime; // stores how much time it took to complete
			current.turnaround_time = current.completion_time - current.arrival_time; //stores the turnaround time
			current.waiting_time = current.turnaround_time - current.Cpu_burst;// stores the waiting time
			Terminated.push_back(current);//pushes into the Terminated queue
			cout << "Process " << current.pid << " completed and moved to Terminated queue.\n";//tells us which process has terminated
		}

	}
	double totalTurnaround = 0;
	double totalWaiting = 0;
	
	cout << "\nRound Robin has been completed!!!" << endl;
	//This part just displays the times
	for (int i = 0; i < Terminated.size(); i++)
	{
		cout << "\nPID = " << Terminated[i].pid
			<< "\nArrival = " << Terminated[i].arrival_time
			<< "\nCompletion = " << Terminated[i].completion_time
			<< "\nTurnaround = " << Terminated[i].turnaround_time
			<< "\nWaiting = " << Terminated[i].waiting_time << endl;

		totalTurnaround += Terminated[i].turnaround_time;//stores the toal turnaround from all of the processes
		totalWaiting += Terminated[i].waiting_time;//stores the total waiting time from all of the processes

	}
	
	double avgTurnaround = totalTurnaround / Terminated.size();//stores the average turnaround
	double avgWaiting = totalWaiting / Terminated.size(); //stores the averatge waiting time
	
	cout << "\nAverage Turnaround Time = " << avgTurnaround << endl;//displays the total turnaround time
	cout << "Average Waiting Time = " << avgWaiting << endl;//displays the total waiting time



}
